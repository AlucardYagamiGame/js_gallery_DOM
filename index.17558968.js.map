"use strict";
var thumbs = document.getElementById("thumbs");
var largeImg = document.getElementById("largeImg");
thumbs.addEventListener("click", function(e) {
    var link = e.target.closest("a");
    if (!link) return;
    e.preventDefault();
    largeImg.src = link.href;
});

